{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "implementation-plan.schema.json",
  "title": "Implementation Plan",
  "description": "Chunked implementation plan with invariants, test specs, and quality gates",

  "type": "object",
  "required": ["meta", "feature", "chunks", "quality_gates"],

  "properties": {
    "meta": {
      "type": "object",
      "required": ["type", "created", "schema_version", "feature_name", "status"],
      "properties": {
        "type": {"const": "plan"},
        "created": {"type": "string", "format": "date-time"},
        "updated": {"type": "string", "format": "date-time"},
        "approved_at": {"type": "string", "format": "date-time"},
        "schema_version": {"type": "string", "default": "1.0"},
        "feature_name": {"type": "string"},
        "status": {
          "type": "string",
          "enum": ["draft", "approved", "in_progress", "completed", "blocked"]
        }
      }
    },

    "feature": {
      "type": "object",
      "required": ["design_doc", "context_packet", "summary"],
      "properties": {
        "design_doc": {"type": "string", "description": "Path to design document"},
        "context_packet": {"type": "string", "description": "Path to feature context packet"},
        "codebase_context": {"type": "string", "default": ".claude/context/_codebase.json"},
        "summary": {"type": "string", "maxLength": 400},
        "goals": {
          "type": "array",
          "items": {"type": "string", "maxLength": 200}
        },
        "primary_block": {"type": "string"},
        "estimated_chunks": {"type": "integer"},
        "estimated_time": {"type": "string", "description": "e.g., '2-3 hours'"}
      }
    },

    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "purpose", "delivers", "scope", "tasks", "invariants"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^chunk-[0-9]{2}$",
            "description": "e.g., chunk-01, chunk-02"
          },
          "name": {
            "type": "string",
            "maxLength": 60,
            "description": "Short descriptive name"
          },
          "purpose": {
            "type": "string",
            "enum": ["foundational", "core_logic", "extension", "integration", "hardening"],
            "description": "Why this chunk exists - determines invariant level requirements"
          },
          "delivers": {
            "type": "string",
            "maxLength": 250,
            "description": "What capability exists after this chunk completes. Must describe a real capability, not just 'X exists'."
          },
          "description": {
            "type": "string",
            "maxLength": 700,
            "description": "What this chunk accomplishes"
          },
          "out_of_scope": {
            "type": "array",
            "items": {"type": "string", "maxLength": 80},
            "description": "Things this chunk must NOT attempt - prevents scope creep"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "review", "completed", "blocked"],
            "default": "pending"
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string", "pattern": "^chunk-[0-9]{2}$"},
            "description": "Chunk IDs that must complete first"
          },
          "scope": {
            "type": "object",
            "required": ["primary_file"],
            "properties": {
              "primary_file": {
                "type": "string",
                "description": "Main file being created or modified"
              },
              "touched_files": {
                "type": "array",
                "items": {"type": "string"},
                "description": "All files affected by this chunk"
              },
              "action": {
                "type": "string",
                "enum": ["create", "modify", "refactor"],
                "description": "Primary action type"
              }
            }
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["task"],
              "properties": {
                "task": {"type": "string", "maxLength": 150},
                "details": {"type": "string", "maxLength": 800},
                "file": {"type": "string", "description": "Specific file if different from primary"}
              }
            }
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "description", "level", "verify"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^inv-[0-9]{2}-[0-9]{2}$",
                  "description": "e.g., inv-01-01 (chunk-invariant)"
                },
                "description": {
                  "type": "string",
                  "maxLength": 200
                },
                "level": {
                  "type": "string",
                  "enum": ["existence", "behavioral", "constraint", "system"],
                  "description": "Semantic strength of this invariant. Must match chunk purpose requirements."
                },
                "verify": {
                  "type": "object",
                  "required": ["command", "expect"],
                  "properties": {
                    "command": {
                      "type": "string",
                      "description": "Shell command to verify invariant"
                    },
                    "expect": {
                      "type": "string",
                      "enum": ["exit_code_0", "exit_code_nonzero", "output_contains", "output_empty"],
                      "description": "What indicates success"
                    },
                    "expect_contains": {
                      "type": "string",
                      "description": "If expect is output_contains, what to look for"
                    }
                  }
                }
              }
            }
          },
          "test_spec": {
            "type": "object",
            "description": "POPULATED DURING TEST ARCHITECTURE PHASE ONLY. Do NOT fill during planning. The test-architecture skill appends this after working with the user on test design.",
            "properties": {
              "test_file": {
                "type": "string",
                "description": "Where tests should be written"
              },
              "test_type": {
                "type": "string",
                "enum": ["unit", "integration", "e2e"]
              },
              "cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "tests"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Test function name"
                    },
                    "tests": {
                      "type": "string",
                      "maxLength": 500,
                      "description": "What this test verifies"
                    },
                    "category": {
                      "type": "string",
                      "enum": ["edge_case", "core_logic", "constraint", "error", "integration",
                               "golden", "log_assertion", "config_sensitivity", "property",
                               "performance", "negative_path"]
                    },
                    "data_strategy": {
                      "type": "string",
                      "maxLength": 80,
                      "description": "Test data layer: L1 golden (config-independent), L2 config-adaptive (helper-derived), L3 property-based (Hypothesis)"
                    },
                    "preconditions": {
                      "type": "array",
                      "items": {"type": "string", "maxLength": 120},
                      "description": "Upstream behavior assertions that must hold before main assertion"
                    }
                  }
                }
              }
            }
          },
          "tested_by": {
            "type": "object",
            "description": "If this chunk cannot be tested alone, specify which chunks test it. Only allowed for 'foundational' purpose chunks.",
            "required": ["chunks", "reason"],
            "properties": {
              "chunks": {
                "type": "array",
                "items": {"type": "string", "pattern": "^chunk-[0-9]{2}$"},
                "description": "Chunk IDs whose tests verify this chunk's correctness"
              },
              "reason": {
                "type": "string",
                "maxLength": 200,
                "description": "Why this chunk cannot be tested independently"
              }
            }
          },
          "session": {
            "type": "object",
            "description": "Session tracking for resumability",
            "properties": {
              "log_file": {"type": "string"},
              "started_at": {"type": "string", "format": "date-time"},
              "last_updated": {"type": "string", "format": "date-time"},
              "resume_point": {
                "type": "string",
                "description": "What to do next if resuming"
              }
            }
          },
          "notes": {
            "type": "string",
            "description": "Additional context for implementer"
          }
        }
      }
    },

    "quality_gates": {
      "type": "object",
      "required": ["gate_script"],
      "properties": {
        "format": {"type": "string", "description": "Format command"},
        "lint": {"type": "string", "description": "Lint command"},
        "typecheck": {"type": "string", "description": "Type check command"},
        "test": {"type": "string", "description": "Test command"},
        "gate_script": {"type": "string", "description": "Comprehensive gate script path"}
      }
    },

    "module_tests": {
      "type": "object",
      "description": "POPULATED DURING TEST ARCHITECTURE PHASE ONLY. Do NOT fill during planning. The test-architecture skill appends this after working with the user on test design.",
      "properties": {
        "integration_scenarios": {
          "type": "array",
          "description": "End-to-end scenarios that test the complete feature",
          "items": {
            "type": "object",
            "required": ["name", "description", "covers"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Scenario identifier"
              },
              "description": {
                "type": "string",
                "maxLength": 500,
                "description": "What this scenario tests"
              },
              "covers": {
                "type": "array",
                "items": {"type": "string", "pattern": "^chunk-[0-9]{2}$"},
                "description": "Which chunks this scenario exercises"
              },
              "setup": {
                "type": "string",
                "maxLength": 200,
                "description": "Required test setup"
              }
            }
          }
        },
        "golden_examples": {
          "type": "array",
          "description": "Known input/output pairs for regression testing",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Example identifier"
              },
              "description": {
                "type": "string",
                "maxLength": 100
              },
              "type": {
                "type": "string",
                "enum": ["normal", "edge_case", "error"],
                "description": "What kind of example this is"
              },
              "input_description": {
                "type": "string",
                "maxLength": 100,
                "description": "What the input represents"
              },
              "expected_behavior": {
                "type": "string",
                "maxLength": 100,
                "description": "What should happen"
              }
            }
          }
        },
        "error_recovery": {
          "type": "array",
          "description": "Error scenarios and expected recovery behavior",
          "items": {
            "type": "object",
            "properties": {
              "trigger": {
                "type": "string",
                "maxLength": 100,
                "description": "What causes the error"
              },
              "expected_handling": {
                "type": "string",
                "maxLength": 100,
                "description": "How the system should respond"
              }
            }
          }
        },
        "performance_criteria": {
          "type": "object",
          "description": "Performance requirements if any",
          "properties": {
            "latency": {
              "type": "string",
              "description": "e.g., '<10ms for 100 candidates'"
            },
            "throughput": {
              "type": "string",
              "description": "e.g., '1000 batches/sec'"
            },
            "memory": {
              "type": "string",
              "description": "e.g., '<100MB for 10k candidates'"
            }
          }
        },
        "config_sensitivity": {
          "type": "object",
          "description": "Config-sensitivity testing plan for Pass B",
          "properties": {
            "dimensions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "impact"],
                "properties": {
                  "name": {"type": "string"},
                  "impact": {"type": "string", "enum": ["high", "medium", "low"]},
                  "test_approach": {"type": "string", "maxLength": 150}
                }
              }
            },
            "breaking_configs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "config_change": {"type": "string", "maxLength": 100},
                  "expected_behavior": {"type": "string", "maxLength": 100}
                }
              }
            },
            "interaction_tests": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "dimensions": {"type": "array", "items": {"type": "string"}},
                  "description": {"type": "string", "maxLength": 150}
                }
              }
            }
          }
        }
      }
    },

    "global_invariants": {
      "type": "array",
      "description": "Invariants that apply after all chunks complete",
      "items": {
        "type": "object",
        "required": ["id", "description", "verify"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string", "maxLength": 200},
          "verify": {
            "type": "object",
            "properties": {
              "command": {"type": "string"},
              "expect": {"type": "string"}
            }
          },
          "required_chunks": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Which chunks must complete for this to be testable"
          }
        }
      }
    },

    "related_context": {
      "type": "object",
      "properties": {
        "codebase": {"type": "string"},
        "feature": {"type": "string"},
        "design": {"type": "string"}
      }
    }
  }
}
