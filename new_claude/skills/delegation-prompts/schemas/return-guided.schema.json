{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guided Delegation Return",
  "description": "Return schema for guided delegation. The sub-agent reports resolved unknowns with confidence levels and decisions made.",
  "type": "object",
  "required": ["delegation_type", "status", "unknowns_resolved", "decisions_made"],
  "properties": {
    "delegation_type": {
      "const": "guided",
      "description": "Must match the delegation type from the prompt."
    },
    "status": {
      "type": "string",
      "enum": ["completed", "partial", "failed"],
      "description": "Overall completion status."
    },
    "unknowns_resolved": {
      "type": "array",
      "description": "Each unknown from the prompt with its answer and confidence.",
      "items": {
        "type": "object",
        "required": ["unknown", "answer", "confidence"],
        "properties": {
          "unknown": { "type": "string", "description": "The original unknown from the prompt." },
          "answer": { "type": "string", "description": "The resolved answer." },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"], "description": "Confidence in the answer." }
        }
      }
    },
    "decisions_made": {
      "type": "array",
      "description": "Decisions made during execution with rationale.",
      "items": {
        "type": "object",
        "required": ["decision", "reason"],
        "properties": {
          "decision": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "unexpected_findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scope_extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["extended_to", "reason"],
        "properties": {
          "extended_to": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "cross_scope_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "relevant_to"],
        "properties": {
          "finding": { "type": "string" },
          "relevant_to": { "type": "string" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "carry_forward": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
