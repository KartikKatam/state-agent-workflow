{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Targeted Delegation Prompt",
  "description": "The spawner knows exactly what needs to be done: specific files, specific changes, specific output. The delegate executes with coordinates, not discovery.",
  "type": "object",
  "required": ["type", "task", "known_context", "output_contract"],
  "properties": {
    "type": {
      "const": "targeted",
      "description": "Delegation type. Use 'targeted' when you have file coordinates and know the solution shape."
    },
    "task": {
      "type": "string",
      "description": "What the delegate should accomplish. One clear sentence."
    },
    "known_context": {
      "type": "object",
      "description": "Everything the spawner already knows. Must include file_coordinates.",
      "required": ["file_coordinates"],
      "properties": {
        "file_coordinates": {
          "type": "array",
          "minItems": 1,
          "description": "Absolute file paths with line numbers. At least one required for targeted delegation.",
          "items": {
            "type": "object",
            "required": ["path", "description"],
            "properties": {
              "path": { "type": "string", "description": "Absolute file path" },
              "lines": { "type": "string", "description": "Line range (e.g., '340-370')" },
              "description": { "type": "string", "description": "What is at this location" }
            }
          }
        },
        "findings": {
          "type": "array",
          "description": "Facts and decisions already established.",
          "items": { "type": "string" }
        },
        "context_packets": {
          "type": "array",
          "description": "Paths to existing context packets.",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "covers": { "type": "string" }
            }
          }
        }
      }
    },
    "output_contract": {
      "type": "object",
      "description": "Exact deliverable specification. Must include format for targeted delegation.",
      "required": ["path", "format"],
      "properties": {
        "path": { "type": "string", "description": "Absolute output path" },
        "format": { "type": "string", "description": "File format or structure description" },
        "schema_example": { "description": "Example of expected output structure" }
      }
    },
    "unknowns": {
      "type": "array",
      "description": "Specific things to verify (not 'investigate X').",
      "items": { "type": "string" }
    },
    "scope_boundary": {
      "type": "object",
      "properties": {
        "do_not": { "type": "array", "items": { "type": "string" } },
        "tool_budget": { "type": "integer" },
        "file_set": { "type": "array", "items": { "type": "string" } }
      }
    },
    "adjacent_context": {
      "type": "array",
      "description": "Fallback resources if the delegate hits an unexpected case.",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "when": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "rejected_approaches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["approach", "reason"],
        "properties": {
          "approach": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "working_directory": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "ptc_available": { "type": "boolean" },
        "mcp_servers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "success_criteria": {
      "type": "array",
      "description": "When to stop. Distinct from output_contract (where/format).",
      "items": { "type": "string" }
    },
    "ptc_hints": {
      "type": "object",
      "description": "PTC loading instructions. See specializations/ptc-delegation.md.",
      "properties": {
        "files_to_load": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "extract": { "type": "string" }
            }
          }
        },
        "namespace_variables": { "type": "array", "items": { "type": "string" } }
      }
    },
    "return_schema": {
      "type": "object",
      "description": "The JSON schema the sub-agent's return must match. Included in the prompt so the sub-agent knows the expected format."
    },
    "return_instruction": {
      "type": "string",
      "description": "Instruction text telling the sub-agent to output only JSON matching return_schema.",
      "default": "Your final output MUST be a single JSON object matching return_schema. No text outside the JSON. Include delegation_type field set to 'targeted'."
    }
  },
  "additionalProperties": true
}
